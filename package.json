{
  "name": "reoclone",
  "version": "1.0.0",
  "description": "Clone the full source and assets of any website into a single ready-to-download zip. No install, works offline.",
  "author": "Abhijit (https://github.com/ab4ijit)",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/ab4ijit/reoclone.git"
  },
  "keywords": [
    "website-cloner",
    "site-ripper",
    "offline",
    "crawler",
    "scraper"
  ],
  "scripts": {
    "start": "node ./bin/www",
    "dev": "node ./bin/www"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "archiver": "^3.1.1",
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "express": "~4.19.2",
    "hbs": "~4.2.0",
    "http-errors": "~1.6.3",
    "morgan": "~1.9.1",
    "socket.io": "^2.5.0",
    "socket.io-client": "^2.5.0"
  }
}
