<main class="page">
  <div class="bg-orbs" aria-hidden="true">
    <span class="orb orb-1"></span>
    <span class="orb orb-2"></span>
    <span class="orb orb-3"></span>
  </div>

  <header class="nav">
    <a class="brand" href="/">
      <span class="brand-mark">◈</span>
      <span class="brand-name">Reo<span class="accent">Clone</span></span>
    </a>
    <a class="nav-link" href="https://github.com/ab4ijit/reoclone" target="_blank" rel="noopener">
      <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
      <span>GitHub</span>
    </a>
  </header>

  <section class="hero">
    <span class="pill">No install · Works offline · One-click zip</span>
    <h1>Clone any website in <span class="accent">seconds</span></h1>
    <p class="sub">ReoClone downloads the full source and every asset of any public website, rewrites the links for offline use, and hands you a single ready-to-open zip.</p>

    <form class="cloner" id="cloner" autocomplete="off">
      <div class="field">
        <span class="field-icon">🌐</span>
        <input type="text" id="website" placeholder="example.com" spellcheck="false" aria-label="Website URL" />
      </div>
      <button type="submit" id="download" class="btn-clone">
        <span class="btn-label">Clone site</span>
        <span class="btn-spin" aria-hidden="true"></span>
      </button>
    </form>

    <div class="hint">Try
      <button class="chip" data-url="https://example.com">example.com</button>
      <button class="chip" data-url="https://motherfuckingwebsite.com">a tiny site</button>
    </div>
  </section>

  <section class="panel" id="panel" hidden>
    <div class="panel-head">
      <div class="status">
        <span class="dot" id="statusDot"></span>
        <span id="statusText">Preparing…</span>
      </div>
      <div class="counter"><strong id="nFiles">0</strong> files</div>
    </div>

    <div class="bar"><div class="bar-fill" id="barFill"></div></div>

    <div class="console" id="log" aria-live="polite"></div>

    <a class="btn-download" id="downloadWebsite" hidden download>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      <span>Download zip</span>
    </a>
  </section>

  <footer class="foot">
    <p>Built by <a href="https://github.com/ab4ijit" target="_blank" rel="noopener">Abhijit</a> · Clone only sites you own or have permission to copy.</p>
  </footer>
</main>

<script>
  (function () {
    var socket = io.connect(document.URL, {
      reconnection: true,
      reconnectionAttempts: Infinity,
      reconnectionDelay: 1000,
      reconnectionDelayMax: 5000,
      timeout: 20000,
    });
    if (!localStorage['reoclone_token']) {
      localStorage['reoclone_token'] = generateToken(24);
    }
    var token = localStorage['reoclone_token'];

    var form = document.getElementById('cloner');
    var input = document.getElementById('website');
    var button = document.getElementById('download');
    var panel = document.getElementById('panel');
    var log = document.getElementById('log');
    var barFill = document.getElementById('barFill');
    var statusText = document.getElementById('statusText');
    var statusDot = document.getElementById('statusDot');
    var nFiles = document.getElementById('nFiles');
    var downloadWebsite = document.getElementById('downloadWebsite');

    var fileCount = 0;
    var busy = false;

    function setStatus(text, state) {
      statusText.textContent = text;
      statusDot.className = 'dot' + (state ? ' ' + state : '');
    }

    function appendLog(line, cls) {
      var el = document.createElement('div');
      el.className = 'line' + (cls ? ' ' + cls : '');
      el.textContent = line;
      log.appendChild(el);
      log.scrollTop = log.scrollHeight;
      while (log.childNodes.length > 200) log.removeChild(log.firstChild);
    }

    function setBusy(state) {
      busy = state;
      button.classList.toggle('loading', state);
      button.disabled = state;
      input.disabled = state;
    }

    function showDownload(event) {
      setBusy(false);
      setStatus('Done', 'done');
      barFill.className = 'bar-fill';
      barFill.style.width = '100%';
      var summary = 'Cloned ' + (event.pages || 0) + ' pages and ' + (event.assets || 0) + ' assets.';
      appendLog(summary, 'ok');

      var url = '/download/' + encodeURIComponent(event.downloadId);
      downloadWebsite.href = url;
      downloadWebsite.hidden = false;
      // Auto-start the download for the user.
      var a = document.createElement('a');
      a.href = url;
      a.download = event.filename || 'clone.zip';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    }

    socket.on(token, function (event) {
      if (event.error) {
        setBusy(false);
        setStatus('Failed', 'error');
        barFill.style.width = '100%';
        barFill.classList.add('error');
        appendLog(event.progress, 'err');
        return;
      }

      if (event.progress === 'Converting') {
        setStatus('Compressing into a zip…', 'busy');
        barFill.style.width = '95%';
        appendLog('All files downloaded — building your zip…', 'ok');
        return;
      }

      if (event.progress === 'Completed') {
        showDownload(event);
        return;
      }

      // Server sends an authoritative running file count with each update.
      if (typeof event.fileCount === 'number') {
        fileCount = event.fileCount;
        nFiles.textContent = fileCount;
        var pct = Math.min(90, 8 + fileCount * 0.12);
        barFill.style.width = pct + '%';
      }
      if (event.resumed) {
        setBusy(true);
        setStatus(event.progress, 'busy');
      }
      appendLog(event.progress);
    });

    // A big clone keeps running on the server even if the socket blips.
    // On drop we DON'T cancel — we show "reconnecting" and let socket.io
    // auto-reconnect, then ask the server to resume our job's state.
    socket.on('disconnect', function () {
      if (busy) {
        setStatus('Reconnecting…', 'busy');
        appendLog('Connection blip — reconnecting, your clone is still running…', 'err');
      }
    });
    socket.on('reconnect', function () {
      appendLog('Reconnected.', 'ok');
      socket.emit('resume', { token: token });
    });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (busy) return;
      var website = input.value.trim();
      if (!website) {
        input.focus();
        return;
      }
      fileCount = 0;
      nFiles.textContent = '0';
      log.innerHTML = '';
      panel.hidden = false;
      barFill.className = 'bar-fill';
      barFill.style.width = '6%';
      downloadWebsite.hidden = true;
      setBusy(true);
      setStatus('Crawling ' + website + '…', 'busy');
      appendLog('Requesting clone of ' + website);
      socket.emit('request', { token: token, website: website });
      panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });

    Array.prototype.forEach.call(document.querySelectorAll('.chip'), function (chip) {
      chip.addEventListener('click', function () {
        input.value = chip.getAttribute('data-url');
        input.focus();
      });
    });

    function generateToken(n) {
      var chars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
      var out = '';
      for (var i = 0; i < n; i++) out += chars[Math.floor(Math.random() * chars.length)];
      return out;
    }
  })();
</script>
